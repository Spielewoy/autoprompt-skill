    "physicalId": "autoprompt.v2.run-owner",
    "layer": "L0",
    "phases": [
      "route-decision",
      "planning",
      "execution-control",
      "independent-checking",
      "completion"
    ],
    "reasoningClass": "decision-and-synthesis",
    "riskClass": "route-independent",
    "legalParents": [
      "deterministic-control-plane"
    ],
    "legalChildren": [
