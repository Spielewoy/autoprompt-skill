  "aliasTelemetrySchema": {
    "format": "jsonl",
    "appendPath": "compatibility/alias-telemetry.jsonl",
    "counterField": "aliasUseCount",
    "enforcer": "deterministic-control-plane",
    "legacyReadVersion": "1",
    "canonicalWriteVersion": "2.0.0",
    "hashChain": {
      "algorithm": "sha256",
      "canonicalization": "stable-json-v1",
      "scope": "append-file",
      "genesisPreviousHash": null,
      "entryHashInputFields": [
        "runId",
        "activationId",
        "generation",
        "legacyId",
        "logicalId",
        "physicalId",
        "legacyReadVersion",
        "canonicalWriteVersion",
        "aliasUseCount",
        "occurredAt",
        "previousHash"
      ],
      "crashTailPolicy": "Preserve and report one unterminated final line as a crash tail; never accept it as a record and never skip a malformed complete line."
    },
    "recordSchema": {
      "type": "object",
      "required": [
        "runId",
        "activationId",
        "generation",
        "legacyId",
        "logicalId",
        "physicalId",
        "legacyReadVersion",
        "canonicalWriteVersion",
        "aliasUseCount",
        "occurredAt",
        "previousHash",
        "entryHash"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 8
        },
        "activationId": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "legacyId": {
          "type": "string",
          "pattern": "^ap-[a-z0-9-]+$"
        },
        "logicalId": {
          "type": "string",
          "minLength": 1
        },
        "physicalId": {
          "type": "string",
          "pattern": "^autoprompt\\.v2\\.[a-z][a-z0-9-]+$"
        },
        "legacyReadVersion": {
          "const": "1"
        },
        "canonicalWriteVersion": {
          "const": "2.0.0"
        },
        "aliasUseCount": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "previousHash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "entryHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
