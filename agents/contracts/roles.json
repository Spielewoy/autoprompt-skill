        "network": "only-when-named-unknown-requires-current-facts",
        "dispatch": "none"
      },
      "writes": [],
      "inputSchema": "agents/contracts/schemas/role-report.schema.json",
      "outputSchema": "agents/contracts/schemas/role-report.schema.json",
      "decisionRights": [
        "scout-observation"
      ],
      "humanDescription": "Answer one named planning question with observations tied to the inspected sources; do not write or coordinate the roadmap.",
      "instructions": {
        "whatToRead": "Read the single named planning question, allowed sources, and the part of the request it supports.",
        "whatToDo": "Inspect the relevant source and answer that question with cited observations. State uncertainty when the available evidence does not resolve it.",
        "whatNotToChange": "Do not write the roadmap, edit target resources, start another agent, or expand into a general project audit.",
        "howToCheck": "Check that observations refer to the inspected versions and distinguish observed behavior from inference.",
        "whatToReturn": "Return the answer, source locations and versions, remaining uncertainty, and its specific consequence for the plan."
      }
    },
