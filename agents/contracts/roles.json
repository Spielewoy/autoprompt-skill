    "outputSchema": "agents/contracts/schemas/outcome.schema.json",
    "decisionRights": [
      "route-choice",
      "success-checklist",
      "worker-selection",
      "checker-selection",
      "route-change",
      "final-user-response"
    ],
    "humanDescription": "Own the route decision, the success checklist, useful assignments, independent checking, and the final response to the user."
  },
  "roles": [
    {
      "id": "route-analyst",
      "physicalId": "autoprompt.v2.route-analyst",
      "layer": "L3",
      "phase": "route-analysis",
      "reasoningClass": "focused-analysis",
      "riskClass": "read-only",
      "allowedRoutes": [
        "PRE_ROUTE"
      ],
      "legalParents": [
        "deterministic-control-plane"
      ],
      "legalChildren": [],
      "permissions": {
        "read": [
          "request-envelope",
          "target",
          "build-and-test-configuration"
        ],
        "write": [],
        "execute": [
          "list",
          "read",
          "search"
        ],
        "network": "none",
        "dispatch": "none"
      },
      "writes": [],
      "inputSchema": "agents/contracts/schemas/request-envelope-entry.schema.json",
      "outputSchema": "agents/contracts/schemas/route-recommendation.schema.json",
      "decisionRights": [
        "route-recommendation"
      ],
      "humanDescription": "Inspect only enough read-only project information to recommend a route and list the facts behind that recommendation.",
      "instructions": {
        "whatToRead": "Read the exact request and the allowed shallow project facts. Use the recorded route predicates and route-analysis deadline.",
        "whatToDo": "Recommend the smallest route whose predicates match the observed facts. Separate established facts from unresolved questions; inspect only what can change the recommendation.",
        "whatNotToChange": "Do not edit files, create a plan, execute production work, or select a route from file count, repository size, or a failed attempt.",
        "howToCheck": "Check each recorded fact against the request or an inspected source. If evidence is insufficient, identify the missing fact instead of inventing a fallback route.",
        "whatToReturn": "Return the schema-valid recommendation, supporting facts, source locations, unresolved questions, and elapsed analysis time."
      }
    },
    {
      "id": "roadmap-author",
      "physicalId": "autoprompt.v2.roadmap-author",
      "layer": "L3",
      "phase": "roadmap-planning",
      "reasoningClass": "dependency-planning",
      "riskClass": "plan-write-only",
      "allowedRoutes": [
        "ROADMAP"
      ],
      "legalParents": [
        "run-owner"
      ],
      "legalChildren": [],
      "permissions": {
        "read": [
          "request-envelope",
          "route-decision",
          "target",
          "named-scout-results"
        ],
        "write": [
          "ROADMAP.md"
        ],
        "execute": [
          "focused-diagnostic-command"
        ],
        "network": "only-when-assigned",
        "dispatch": "none"
      },
      "writes": [
        "run:plan/ROADMAP.md"
      ],
      "inputSchema": "agents/contracts/schemas/role-report.schema.json",
      "outputSchema": "agents/contracts/schemas/role-report.schema.json",
      "decisionRights": [
        "roadmap-content"
      ],
      "humanDescription": "Write one dependency-ordered roadmap with owners, integration points, success items, and real checks.",
      "instructions": {
        "whatToRead": "Read the bound request, selected ROADMAP route, owned plan path, relevant repository interfaces, and any named scout results.",
        "whatToDo": "Write a plan covering every requested result with dependencies, owners, integration work, acceptance checks, and relevant failure cases. In repair mode, correct the rejected items and retain valid evidence.",
        "whatNotToChange": "Do not edit production resources, start other agents, add unrelated requirements, or make product choices reserved for the user.",
        "howToCheck": "Confirm each work item supports a request item, every dependency is ordered, shared writes have an ownership transfer, and each requested effect has an executable or observable check.",
        "whatToReturn": "Return the exact plan version, request coverage, unresolved decisions, needed scout observations, and evidence for any requested change to the plan."
      }
    },
    {
      "id": "scout",
      "physicalId": "autoprompt.v2.scout",
      "layer": "L3",
      "phase": "roadmap-planning",
      "reasoningClass": "focused-analysis",
