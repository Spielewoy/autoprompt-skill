{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoprompt.dev/schemas/codex-verification-bundle.v1.json",
  "title": "Content-addressed Codex verification bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "bundle_hash", "bundle_hash_algorithm", "scope", "result", "independent",
    "finding_ids", "finding_reviews", "runner_id", "reviewer_id", "reviewed_at", "execution_hash",
    "command_argv", "command_hash", "cwd", "started_at", "ended_at", "exit_code", "signal",
    "candidate_hash", "post_candidate_hash", "candidate_unchanged", "environment_hash", "raw_output_sha256",
    "raw_output_bytes", "stderr_sha256", "stderr_bytes", "candidate_manifest_sha256",
    "environment_manifest_sha256", "execution_record_sha256", "reviewer_verdict_sha256", "finding_registry_sha256", "redaction",
    "bundle_path", "raw_output_path", "stderr_path", "candidate_manifest_path", "environment_manifest_path",
    "execution_record_path", "reviewer_verdict_path", "finding_registry_path"
  ],
  "properties": {
    "schema_version": { "const": "codex-verification-bundle.v1" },
    "id": { "type": "string", "pattern": "^verification:[a-f0-9]{64}$" },
    "bundle_hash": { "$ref": "#/$defs/sha256" },
    "bundle_hash_algorithm": { "const": "sha256-canonical-json-derived-paths-v1" },
    "scope": { "const": "codex-only" },
    "result": { "enum": ["PASS", "FAIL"] },
    "independent": { "const": true },
    "finding_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/finding" } },
    "finding_reviews": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/findingReview" } },
    "runner_id": { "$ref": "#/$defs/actor" },
    "reviewer_id": { "$ref": "#/$defs/actor" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "execution_hash": { "$ref": "#/$defs/sha256" },
    "command_argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "command_hash": { "$ref": "#/$defs/sha256" },
    "cwd": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "exit_code": { "type": ["integer", "null"] },
    "signal": { "type": ["string", "null"] },
    "candidate_hash": { "$ref": "#/$defs/sha256" },
    "post_candidate_hash": { "$ref": "#/$defs/sha256" },
    "candidate_unchanged": { "type": "boolean" },
    "environment_hash": { "$ref": "#/$defs/sha256" },
    "raw_output_sha256": { "$ref": "#/$defs/sha256" },
    "raw_output_bytes": { "type": "integer", "minimum": 0 },
    "stderr_sha256": { "$ref": "#/$defs/sha256" },
    "stderr_bytes": { "type": "integer", "minimum": 0 },
    "candidate_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "environment_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "execution_record_sha256": { "$ref": "#/$defs/sha256" },
    "reviewer_verdict_sha256": { "$ref": "#/$defs/sha256" },
    "finding_registry_sha256": { "$ref": "#/$defs/sha256" },
    "redaction": { "$ref": "codex-verification-execution.schema.json#/properties/redaction" },
    "bundle_path": { "$ref": "#/$defs/repoPath" },
    "raw_output_path": { "$ref": "#/$defs/repoPath" },
    "stderr_path": { "$ref": "#/$defs/repoPath" },
    "candidate_manifest_path": { "$ref": "#/$defs/repoPath" },
    "environment_manifest_path": { "$ref": "#/$defs/repoPath" },
    "execution_record_path": { "$ref": "#/$defs/repoPath" },
    "reviewer_verdict_path": { "$ref": "#/$defs/repoPath" },
    "finding_registry_path": { "$ref": "#/$defs/repoPath" }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "PASS" } }, "required": ["result"] },
      "then": { "properties": { "exit_code": { "const": 0 }, "signal": { "const": null }, "candidate_unchanged": { "const": true } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{2,255}$" },
    "finding": { "type": "string", "pattern": "^AP-[A-Z]+-[0-9]{3}$" },
    "repoPath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "findingReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "justification"],
      "properties": {
        "finding_id": { "$ref": "#/$defs/finding" },
        "justification": { "type": "string", "minLength": 24 }
      }
    }
  }
}
