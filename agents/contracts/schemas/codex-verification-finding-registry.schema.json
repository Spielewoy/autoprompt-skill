{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoprompt.dev/schemas/codex-verification-finding-registry.v1.json",
  "title": "Sealed Codex verification finding authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_path", "map_sha256", "findings"],
  "properties": {
    "schema_version": { "const": "codex-verification-finding-registry.v1" },
    "map_path": { "const": "AUTOPROMPT-TOTAL-FIX-MAP.md" },
    "map_sha256": { "$ref": "#/$defs/sha256" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "row_sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^AP-[A-Z]+-[0-9]{3}$" },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "row_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
