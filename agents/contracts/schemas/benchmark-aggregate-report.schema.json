{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoprompt.dev/schemas/benchmark-aggregate-report.v2.json",
  "title": "Autoprompt signed benchmark aggregate report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "manifestId", "manifestDigest", "catalog", "pricing", "attempts", "terminalStates", "costsByArm", "tokensByArm", "costPerAcceptedSolve", "spansMs", "livePartial", "controlledEffectEligible", "analysisClass", "canarySummary", "claimProvenance", "executionLedger", "reconstructionInputs", "trustMetadata", "evidenceObjects", "reportDigest", "signature"],
  "properties": {
    "schemaVersion": { "const": "benchmark-aggregate.v2" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "manifestId": { "$ref": "#/$defs/nonEmpty" },
    "manifestDigest": { "$ref": "#/$defs/sha256" },
    "catalog": { "$ref": "#/$defs/catalog" },
    "pricing": { "$ref": "#/$defs/pricing" },
    "attempts": { "$ref": "#/$defs/attempts" },
    "terminalStates": { "$ref": "#/$defs/terminalStates" },
    "costsByArm": { "type": "object", "minProperties": 3, "additionalProperties": { "$ref": "#/$defs/costs" } },
    "tokensByArm": { "type": "object", "minProperties": 3, "additionalProperties": { "$ref": "#/$defs/tokens" } },
    "costPerAcceptedSolve": { "type": "object", "minProperties": 3, "additionalProperties": { "type": ["number", "null"], "minimum": 0 } },
    "spansMs": { "$ref": "#/$defs/spans" },
    "livePartial": { "type": "boolean" },
    "controlledEffectEligible": { "type": "boolean" },
    "analysisClass": { "enum": ["controlled-effects", "descriptive-only"] },
    "canarySummary": { "$ref": "#/$defs/canarySummary" },
    "claimProvenance": { "$ref": "#/$defs/claimProvenance" },
    "executionLedger": { "$ref": "#/$defs/ledger" },
    "reconstructionInputs": { "$ref": "#/$defs/reconstructionInputs" },
    "trustMetadata": { "$ref": "#/$defs/trustMetadata" },
    "evidenceObjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/object" } },
    "reportDigest": { "$ref": "#/$defs/sha256" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "allOf": [
    { "if": { "properties": { "controlledEffectEligible": { "const": true } }, "required": ["controlledEffectEligible"] }, "then": { "properties": { "analysisClass": { "const": "controlled-effects" }, "livePartial": { "const": false }, "trustMetadata": { "properties": { "fixtureOnly": { "const": false } } }, "catalog": { "properties": { "fixtureOnly": { "const": false } } }, "canarySummary": { "properties": { "ready": { "const": true }, "terminalImmutable": { "const": true } } }, "executionLedger": { "properties": { "complete": { "const": true } } } } } },
    { "if": { "properties": { "analysisClass": { "const": "controlled-effects" } }, "required": ["analysisClass"] }, "then": { "properties": { "controlledEffectEligible": { "const": true } } } }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "portablePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F:])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))(?!.*(?:^|/)[^/]*[. ](?:/|$))[^/]+(?:/[^/]+)*$" },
    "catalog": { "type": "object", "additionalProperties": false, "required": ["catalogId", "digest", "taskCount", "issuer", "keyId", "fixtureOnly"], "properties": { "catalogId": { "$ref": "#/$defs/nonEmpty" }, "digest": { "$ref": "#/$defs/sha256" }, "taskCount": { "type": "integer", "minimum": 1 }, "issuer": { "$ref": "#/$defs/nonEmpty" }, "keyId": { "$ref": "#/$defs/nonEmpty" }, "fixtureOnly": { "type": "boolean" } } },
    "pricing": { "type": "object", "additionalProperties": false, "required": ["pricingId", "digest", "currency"], "properties": { "pricingId": { "$ref": "#/$defs/nonEmpty" }, "digest": { "$ref": "#/$defs/sha256" }, "currency": { "$ref": "#/$defs/nonEmpty" } } },
    "attempts": { "type": "object", "additionalProperties": false, "required": ["total", "scored", "repairs", "canaries", "censored"], "properties": { "total": { "type": "integer", "minimum": 0 }, "scored": { "type": "integer", "minimum": 0 }, "repairs": { "type": "integer", "minimum": 0 }, "canaries": { "type": "integer", "minimum": 0 }, "censored": { "type": "integer", "minimum": 0 } } },
    "terminalStates": { "type": "object", "additionalProperties": false, "properties": { "PASS": { "type": "integer", "minimum": 0 }, "FAIL": { "type": "integer", "minimum": 0 }, "CANCELLED": { "type": "integer", "minimum": 0 }, "CENSORED": { "type": "integer", "minimum": 0 }, "CRASH": { "type": "integer", "minimum": 0 }, "LIVE": { "type": "integer", "minimum": 0 }, "ABSENT": { "type": "integer", "minimum": 0 }, "UNKNOWN": { "type": "integer", "minimum": 0 } } },
    "costs": { "type": "object", "additionalProperties": false, "required": ["model", "host", "storage", "setup", "canary", "repair", "scoredRun", "total"], "properties": { "model": { "type": "number", "minimum": 0 }, "host": { "type": "number", "minimum": 0 }, "storage": { "type": "number", "minimum": 0 }, "setup": { "type": "number", "minimum": 0 }, "canary": { "type": "number", "minimum": 0 }, "repair": { "type": "number", "minimum": 0 }, "scoredRun": { "type": "number", "minimum": 0 }, "total": { "type": "number", "minimum": 0 } } },
    "tokens": { "type": "object", "additionalProperties": false, "required": ["noncachedInput", "cachedInput", "output", "reasoning"], "properties": { "noncachedInput": { "type": "integer", "minimum": 0 }, "cachedInput": { "type": "integer", "minimum": 0 }, "output": { "type": "integer", "minimum": 0 }, "reasoning": { "type": "integer", "minimum": 0 } } },
    "spans": { "type": "object", "additionalProperties": false, "required": ["planning", "execution", "review", "repair", "unknown"], "properties": { "planning": { "type": "integer", "minimum": 0 }, "execution": { "type": "integer", "minimum": 0 }, "review": { "type": "integer", "minimum": 0 }, "repair": { "type": "integer", "minimum": 0 }, "unknown": { "type": "integer", "minimum": 0 } } },
    "canarySummary": { "type": "object", "additionalProperties": false, "required": ["ready", "expected", "completed", "terminalImmutable", "digest"], "properties": { "ready": { "type": "boolean" }, "expected": { "type": "integer", "minimum": 0 }, "completed": { "type": "integer", "minimum": 0 }, "terminalImmutable": { "type": "boolean" }, "digest": { "$ref": "#/$defs/sha256" } } },
    "immutableClaim": { "type": "object", "additionalProperties": false, "required": ["attemptId", "observedAt", "sessionIds", "snapshotId", "snapshotDigest"], "properties": { "attemptId": { "$ref": "#/$defs/nonEmpty" }, "observedAt": { "type": "string", "format": "date-time" }, "sessionIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }, "snapshotId": { "$ref": "#/$defs/nonEmpty" }, "snapshotDigest": { "$ref": "#/$defs/sha256" } } },
    "liveClaim": { "type": "object", "additionalProperties": false, "required": ["attemptId", "observedAt", "sessionIds", "sourceRunId", "sourceRelativePath"], "properties": { "attemptId": { "$ref": "#/$defs/nonEmpty" }, "observedAt": { "type": "string", "format": "date-time" }, "sessionIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }, "sourceRunId": { "$ref": "#/$defs/nonEmpty" }, "sourceRelativePath": { "$ref": "#/$defs/portablePath" } } },
    "claimProvenance": { "type": "object", "additionalProperties": false, "required": ["immutable", "livePartial"], "properties": { "immutable": { "type": "array", "items": { "$ref": "#/$defs/immutableClaim" } }, "livePartial": { "type": "array", "items": { "$ref": "#/$defs/liveClaim" } } } },
    "ledger": { "type": "object", "additionalProperties": false, "required": ["relativePath", "sha256", "bytes", "entries", "complete"], "properties": { "relativePath": { "$ref": "#/$defs/portablePath" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 }, "entries": { "type": "integer", "minimum": 0 }, "complete": { "type": "boolean" } } },
    "reconstructionInputs": { "type": "object", "additionalProperties": false, "required": ["manifest", "catalog", "pricing", "trustRegistry"], "properties": { "manifest": { "$ref": "#/$defs/blob" }, "catalog": { "$ref": "#/$defs/blob" }, "pricing": { "$ref": "#/$defs/blob" }, "trustRegistry": { "$ref": "#/$defs/blob" } } },
    "blob": { "type": "object", "additionalProperties": false, "required": ["relativePath", "sha256", "bytes"], "properties": { "relativePath": { "$ref": "#/$defs/portablePath" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 } } },
    "trustIdentity": { "type": "object", "additionalProperties": false, "required": ["issuer", "keyId", "fixtureOnly"], "properties": { "issuer": { "$ref": "#/$defs/nonEmpty" }, "keyId": { "$ref": "#/$defs/nonEmpty" }, "fixtureOnly": { "type": "boolean" } } },
    "trustMetadata": { "type": "object", "additionalProperties": false, "required": ["catalog", "manifest", "aggregate", "providerReceipt", "verifier", "controller", "fixtureOnly"], "properties": { "catalog": { "$ref": "#/$defs/trustIdentity" }, "manifest": { "$ref": "#/$defs/trustIdentity" }, "aggregate": { "$ref": "#/$defs/trustIdentity" }, "providerReceipt": { "$ref": "#/$defs/trustIdentity" }, "verifier": { "$ref": "#/$defs/trustIdentity" }, "controller": { "$ref": "#/$defs/trustIdentity" }, "fixtureOnly": { "type": "boolean" } } },
    "object": { "type": "object", "additionalProperties": false, "required": ["digest", "relativePath"], "properties": { "digest": { "$ref": "#/$defs/sha256" }, "relativePath": { "$ref": "#/$defs/portablePath" } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "issuer", "keyId", "value"], "properties": { "algorithm": { "const": "ed25519" }, "issuer": { "$ref": "#/$defs/nonEmpty" }, "keyId": { "$ref": "#/$defs/nonEmpty" }, "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" } } }
  }
}
