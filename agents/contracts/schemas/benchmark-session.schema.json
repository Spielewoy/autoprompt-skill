{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoprompt.dev/schemas/benchmark-session.v2.json",
  "title": "Autoprompt exact benchmark model session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "parentSessionId", "rootSessionId", "attemptId", "role", "model", "startedAt", "endedAt", "usage", "spans"],
  "properties": {
    "schemaVersion": { "const": "benchmark-session.v2" },
    "sessionId": { "$ref": "#/$defs/nonEmpty" },
    "parentSessionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonEmpty" }] },
    "rootSessionId": { "$ref": "#/$defs/nonEmpty" },
    "attemptId": { "$ref": "#/$defs/nonEmpty" },
    "role": { "$ref": "#/$defs/nonEmpty" },
    "model": { "$ref": "#/$defs/model" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "usage": { "$ref": "#/$defs/usage" },
    "spans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/span" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "model": { "type": "object", "additionalProperties": false, "required": ["provider", "name", "version"], "properties": { "provider": { "$ref": "#/$defs/nonEmpty" }, "name": { "$ref": "#/$defs/nonEmpty" }, "version": { "$ref": "#/$defs/nonEmpty" } } },
    "usage": { "type": "object", "additionalProperties": false, "required": ["inputTokens", "cachedInputTokens", "outputTokens", "reasoningTokens"], "properties": { "inputTokens": { "type": "integer", "minimum": 0 }, "cachedInputTokens": { "type": "integer", "minimum": 0 }, "outputTokens": { "type": "integer", "minimum": 0 }, "reasoningTokens": { "type": "integer", "minimum": 0 } } },
    "span": { "type": "object", "additionalProperties": false, "required": ["spanId", "kind", "startedAt", "endedAt"], "properties": { "spanId": { "$ref": "#/$defs/nonEmpty" }, "kind": { "enum": ["planning", "execution", "review", "repair", "unknown"] }, "startedAt": { "type": "string", "format": "date-time" }, "endedAt": { "type": "string", "format": "date-time" } } }
  }
}
