{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoprompt.local/schemas/v2/state-event.schema.json",
  "title": "One Autoprompt v2 events.jsonl entry",
  "type": "object",
  "required": [
    "contractVersion",
    "transitionId",
    "eventId",
    "runId",
    "activationNonce",
    "sequence",
    "fromState",
    "toState",
    "requestEnvelopeHash",
    "targetIdentityHash",
    "candidateHash",
    "evidenceHashes",
    "openIds",
    "attempt",
    "causalParent",
    "occurredAt",
    "humanDescription"
  ],
  "properties": {
    "contractVersion": {
      "const": "2.0.0"
    },
    "transitionId": {
      "type": "string",
      "pattern": "^T[0-9]{3}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "runId": {
      "type": "string",
      "minLength": 8
    },
    "activationNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "fromState": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "toState": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "requestEnvelopeHash": {
      "$ref": "#/$defs/sha256"
    },
    "targetIdentityHash": {
      "$ref": "#/$defs/sha256"
    },
    "candidateHash": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceHashes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "openIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "causalParent": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "humanDescription": {
      "type": "string",
      "minLength": 1
    },
    "resourceState": {
      "type": "object"
    },
    "retryState": {
      "type": "object"
    },
    "recoveryContext": {
      "$ref": "#/$defs/recoveryContext"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {"properties":{"transitionId":{"const":"T001"},"eventId":{"const":"BOOTSTRAP"},"fromState":{"const":"BOOT"},"toState":{"const":"LOAD_SKILL"}},"required":["transitionId","eventId","fromState","toState"]},
