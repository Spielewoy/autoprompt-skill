  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recoveryContext": {
      "type": "object",
      "required": [
        "savedState",
        "resumeState",
        "checkpointHash",
        "frontierHash",
        "frontier",
        "completedMilestones",
        "priorOwner",
        "externalRecovery",
        "releaseIntentHash",
        "accountingCheckpoint"
      ],
      "properties": {
        "savedState": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "resumeState": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "checkpointHash": { "$ref": "#/$defs/sha256" },
        "frontierHash": { "$ref": "#/$defs/sha256" },
        "frontier": {
          "type": "object",
          "required": ["nextReadyWorkIds", "openCheckIds", "acceptedResultIds"],
          "properties": {
            "nextReadyWorkIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "openCheckIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "acceptedResultIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "completedMilestones": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["route-analysis", "route-decision", "work-preparation", "external-prepare", "external-commit", "external-reconcile", "final-check"] }
        },
        "priorOwner": {
          "type": "object",
          "required": ["ownerId", "staleOwnerEvidenceHash", "processesDrained", "processDrainEvidenceHash"],
          "properties": {
            "ownerId": { "type": "string", "minLength": 1 },
            "staleOwnerEvidenceHash": { "$ref": "#/$defs/sha256" },
            "processesDrained": { "const": true },
            "processDrainEvidenceHash": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "externalRecovery": {
          "type": "object",
          "required": ["status", "operationIds", "idempotencyKeys", "receiptHashes"],
          "properties": {
            "status": { "enum": ["none", "reconciliation-required"] },
            "operationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "idempotencyKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "receiptHashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }
          },
          "additionalProperties": false
        },
        "releaseIntentHash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "accountingCheckpoint": {
          "type": "object",
          "required": ["snapshotHash", "lastAccountingSequence", "lastAccountingHash"],
          "properties": {
            "snapshotHash": { "$ref": "#/$defs/sha256" },
            "lastAccountingSequence": { "type": "integer", "minimum": 1 },
            "lastAccountingHash": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "externalRecovery": { "properties": { "status": { "const": "reconciliation-required" } }, "required": ["status"] } },
            "required": ["externalRecovery"]
          },
          "then": {
            "properties": {
              "resumeState": { "const": "CHECK_WORK" },
              "externalRecovery": {
                "properties": {
                  "operationIds": { "minItems": 1 },
                  "idempotencyKeys": { "minItems": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
