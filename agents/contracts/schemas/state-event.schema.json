    {"properties":{"transitionId":{"const":"T015"},"eventId":{"const":"ROUTE_ANALYST_STARTED"},"fromState":{"const":"START_ROUTE_ANALYST"},"toState":{"const":"SAVE_ROUTE_ANALYSIS"}},"required":["transitionId","eventId","fromState","toState"]},
