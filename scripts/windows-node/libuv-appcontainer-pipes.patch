+/* Determine authority from the actual token, never an environment flag.
+ * Do not cache: each pipe pair owns one bounded query and closes its token.
+ * Unknown identity must refuse rather than select the unrestricted namespace.
+ */
+static int uv__pipe_is_appcontainer(int* is_appcontainer) {
+  HANDLE token;
+  DWORD value;
+  DWORD returned;
+  DWORD error;
+  int queried;
+
+  token = NULL;
+  value = 0;
+  returned = 0;
+  *is_appcontainer = 0;
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) {
+    error = GetLastError();
+    return error != 0 ? error : ERROR_INVALID_DATA;
+  }
+
+  queried = GetTokenInformation(token,
+                               TokenIsAppContainer,
+                               &value,
+                               sizeof(value),
+                               &returned);
+  error = queried ? 0 : GetLastError();
+  if (!queried && error == 0)
+    error = ERROR_INVALID_DATA;
+  if (queried && (returned != sizeof(value) || value > 1))
+    error = ERROR_INVALID_DATA;
+  if (!CloseHandle(token) && error == 0) {
+    error = GetLastError();
+    if (error == 0)
+      error = ERROR_INVALID_DATA;
+  }
+  if (error != 0)
+    return error;
+
+  *is_appcontainer = value != 0;
+  return 0;
+}
+
+
+static int uv__unique_pipe_name(unsigned long long ptr,
+                               char* name,
+                               size_t size,
+                               int is_appcontainer) {
+  int length;
+
+  /* LOCAL is virtualized by Windows. Keep its generated leaf flat; do not
+   * manufacture a package SID path or rely on a nested NPFS directory.
+   * Preserve the original ordinary-host namespace byte for byte.
+   */
+  length = snprintf(name,
+                    size,
+                    is_appcontainer ? "\\\\.\\pipe\\LOCAL\\uv-%llu-%lu"
+                                    : "\\\\?\\pipe\\uv\\%llu-%lu",
+                    ptr,
+                    GetCurrentProcessId());
+  if (length < 0 || (size_t) length >= size)
+    return ERROR_INSUFFICIENT_BUFFER;
+  return 0;
 }
 
 
