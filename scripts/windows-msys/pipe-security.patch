diff --git a/winsup/cygwin/local_includes/appcontainer_nt_security.h b/winsup/cygwin/local_includes/appcontainer_nt_security.h
new file mode 100644
--- /dev/null
+++ b/winsup/cygwin/local_includes/appcontainer_nt_security.h
@@ -0,0 +1,114 @@
+/* Loader-lock-safe security operations. All security entry points are direct
+   ntdll imports: never enter Cygwin's ADVAPI32 autoload thunks during fork.
+   BOOL/BOOLEAN and NTSTATUS/Win32 error contracts are translated explicitly. */
+#ifndef APPCONTAINER_NT_SECURITY_H
+#define APPCONTAINER_NT_SECURITY_H
+namespace appcontainer_nt
+{
+extern "C" {
+  LONG NTAPI NtOpenProcessToken (HANDLE, ACCESS_MASK, PHANDLE);
+  LONG NTAPI NtQueryInformationToken (HANDLE, TOKEN_INFORMATION_CLASS, PVOID, ULONG, PULONG);
+  ULONG NTAPI RtlNtStatusToDosError (LONG);
+  BOOLEAN NTAPI RtlValidSid (PSID);
+  ULONG NTAPI RtlLengthSid (PSID);
+  ULONG NTAPI RtlLengthRequiredSid (ULONG);
+  PUCHAR NTAPI RtlSubAuthorityCountSid (PSID);
+  PULONG NTAPI RtlSubAuthoritySid (PSID, ULONG);
+  LONG NTAPI RtlCopySid (ULONG, PSID, PSID);
+  LONG NTAPI RtlInitializeSid (PSID, PSID_IDENTIFIER_AUTHORITY, UCHAR);
+  BOOLEAN NTAPI RtlValidAcl (PACL);
+  LONG NTAPI RtlQueryInformationAcl (PACL, PVOID, ULONG, ACL_INFORMATION_CLASS);
+  BOOLEAN NTAPI RtlValidSecurityDescriptor (PSECURITY_DESCRIPTOR);
+  BOOLEAN NTAPI RtlValidRelativeSecurityDescriptor (PSECURITY_DESCRIPTOR, ULONG, SECURITY_INFORMATION);
+  ULONG NTAPI RtlLengthSecurityDescriptor (PSECURITY_DESCRIPTOR);
+  LONG NTAPI RtlGetControlSecurityDescriptor (PSECURITY_DESCRIPTOR, PSECURITY_DESCRIPTOR_CONTROL, PULONG);
+  LONG NTAPI RtlGetOwnerSecurityDescriptor (PSECURITY_DESCRIPTOR, PSID *, PBOOLEAN);
+  LONG NTAPI RtlGetGroupSecurityDescriptor (PSECURITY_DESCRIPTOR, PSID *, PBOOLEAN);
+  LONG NTAPI RtlGetDaclSecurityDescriptor (PSECURITY_DESCRIPTOR, PBOOLEAN, PACL *, PBOOLEAN);
+  LONG NTAPI RtlGetSaclSecurityDescriptor (PSECURITY_DESCRIPTOR, PBOOLEAN, PACL *, PBOOLEAN);
+  BOOLEAN NTAPI RtlGetSecurityDescriptorRMControl (PSECURITY_DESCRIPTOR, PUCHAR);
+  LONG NTAPI RtlCreateSecurityDescriptor (PSECURITY_DESCRIPTOR, ULONG);
+  LONG NTAPI RtlCreateAcl (PACL, ULONG, ULONG);
+  LONG NTAPI RtlAddAce (PACL, ULONG, ULONG, PVOID, ULONG);
+  LONG NTAPI RtlAddAccessAllowedAceEx (PACL, ULONG, ULONG, ACCESS_MASK, PSID);
+  LONG NTAPI RtlSetOwnerSecurityDescriptor (PSECURITY_DESCRIPTOR, PSID, BOOLEAN);
+  LONG NTAPI RtlSetGroupSecurityDescriptor (PSECURITY_DESCRIPTOR, PSID, BOOLEAN);
+  LONG NTAPI RtlSetDaclSecurityDescriptor (PSECURITY_DESCRIPTOR, BOOLEAN, PACL, BOOLEAN);
+  LONG NTAPI RtlSetSaclSecurityDescriptor (PSECURITY_DESCRIPTOR, BOOLEAN, PACL, BOOLEAN);
+  LONG NTAPI RtlSetControlSecurityDescriptor (PSECURITY_DESCRIPTOR, SECURITY_DESCRIPTOR_CONTROL, SECURITY_DESCRIPTOR_CONTROL);
+  VOID NTAPI RtlSetSecurityDescriptorRMControl (PSECURITY_DESCRIPTOR, PUCHAR);
+}
+inline BOOL success (LONG status)
+{
+  if (status >= 0) return TRUE;
+  SetLastError (RtlNtStatusToDosError (status));
+  return FALSE;
+}
+inline BOOL OpenProcessToken (HANDLE process, DWORD access, PHANDLE token)
+{ return success (NtOpenProcessToken (process, access, token)); }
+inline BOOL GetTokenInformation (HANDLE token, TOKEN_INFORMATION_CLASS kind, PVOID data, DWORD size, PDWORD returned)
+{ ULONG length = 0; LONG status = NtQueryInformationToken (token, kind, data, size, &length); *returned = length; return success (status); }
+inline PUCHAR GetSidSubAuthorityCount (PSID sid) { return RtlSubAuthorityCountSid (sid); }
+inline DWORD GetSidLengthRequired (UCHAR count) { return RtlLengthRequiredSid (count); }
+inline BOOL IsValidSid (PSID sid) { return RtlValidSid (sid) != FALSE; }
+inline DWORD GetLengthSid (PSID sid) { return RtlLengthSid (sid); }
+inline BOOL CopySid (DWORD size, PSID destination, PSID source) { return success (RtlCopySid (size, destination, source)); }
+inline BOOL CreateWellKnownSid (WELL_KNOWN_SID_TYPE kind, PSID domain, PSID sid, PDWORD size)
+{
+  if (kind != WinLocalSystemSid || domain || !size || *size < 12)
+    { SetLastError (ERROR_INVALID_PARAMETER); return FALSE; }
+  SID_IDENTIFIER_AUTHORITY authority = SECURITY_NT_AUTHORITY;
+  if (!success (RtlInitializeSid (sid, &authority, 1))) return FALSE;
+  *RtlSubAuthoritySid (sid, 0) = SECURITY_LOCAL_SYSTEM_RID;
+  *size = 12;
+  return TRUE;
+}
+inline BOOL IsValidAcl (PACL acl) { return RtlValidAcl (acl) != FALSE; }
+inline BOOL GetAclInformation (PACL acl, PVOID data, DWORD size, ACL_INFORMATION_CLASS kind)
+{ return success (RtlQueryInformationAcl (acl, data, size, kind)); }
+inline BOOL GetSecurityDescriptorControl (PSECURITY_DESCRIPTOR sd, PSECURITY_DESCRIPTOR_CONTROL control, PDWORD revision)
+{ ULONG value = 0; LONG status = RtlGetControlSecurityDescriptor (sd, control, &value); *revision = value; return success (status); }
+inline BOOL IsValidSecurityDescriptor (PSECURITY_DESCRIPTOR sd)
+{
+  if (!sd) return FALSE;
+  SECURITY_DESCRIPTOR_CONTROL control = 0; ULONG revision = 0;
+  if (RtlGetControlSecurityDescriptor (sd, &control, &revision) < 0 || revision != SECURITY_DESCRIPTOR_REVISION) return FALSE;
+  if (!(control & SE_SELF_RELATIVE)) return RtlValidSecurityDescriptor (sd) != FALSE;
+  // SDDL native fixtures supply relative descriptors. Keep that support and
+  // bound the computed length before the relative validator. This does not
+  // establish allocation extent: callers still provide readable descriptor
+  // storage, as for the original Win32 API. Never treat one as absolute.
+  ULONG size = RtlLengthSecurityDescriptor (sd);
+  return size >= sizeof (SECURITY_DESCRIPTOR_RELATIVE) && size <= 128 * 1024
+    && RtlValidRelativeSecurityDescriptor (sd, size, 0) != FALSE;
+}
+inline BOOL GetSecurityDescriptorOwner (PSECURITY_DESCRIPTOR sd, PSID *sid, PBOOL defaulted)
+{ BOOLEAN flag = FALSE; LONG status = RtlGetOwnerSecurityDescriptor (sd, sid, &flag); if (status >= 0) *defaulted = flag; return success (status); }
+inline BOOL GetSecurityDescriptorGroup (PSECURITY_DESCRIPTOR sd, PSID *sid, PBOOL defaulted)
+{ BOOLEAN flag = FALSE; LONG status = RtlGetGroupSecurityDescriptor (sd, sid, &flag); if (status >= 0) *defaulted = flag; return success (status); }
+inline BOOL GetSecurityDescriptorDacl (PSECURITY_DESCRIPTOR sd, PBOOL present, PACL *acl, PBOOL defaulted)
+{ BOOLEAN exists = FALSE, flag = FALSE; LONG status = RtlGetDaclSecurityDescriptor (sd, &exists, acl, &flag); if (status >= 0) { *present = exists; *defaulted = flag; } return success (status); }
+inline BOOL GetSecurityDescriptorSacl (PSECURITY_DESCRIPTOR sd, PBOOL present, PACL *acl, PBOOL defaulted)
+{ BOOLEAN exists = FALSE, flag = FALSE; LONG status = RtlGetSaclSecurityDescriptor (sd, &exists, acl, &flag); if (status >= 0) { *present = exists; *defaulted = flag; } return success (status); }
+inline DWORD GetSecurityDescriptorRMControl (PSECURITY_DESCRIPTOR sd, PUCHAR value)
+{ return RtlGetSecurityDescriptorRMControl (sd, value) ? ERROR_SUCCESS : ERROR_INVALID_SECURITY_DESCR; }
+inline BOOL InitializeSecurityDescriptor (PSECURITY_DESCRIPTOR sd, DWORD revision)
+{ return success (RtlCreateSecurityDescriptor (sd, revision)); }
+inline BOOL InitializeAcl (PACL acl, DWORD size, DWORD revision) { return success (RtlCreateAcl (acl, size, revision)); }
+inline BOOL AddAce (PACL acl, DWORD revision, DWORD index, PVOID bytes, DWORD size) { return success (RtlAddAce (acl, revision, index, bytes, size)); }
+inline BOOL AddAccessAllowedAceEx (PACL acl, DWORD revision, DWORD flags, DWORD access, PSID sid)
+{ return success (RtlAddAccessAllowedAceEx (acl, revision, flags, access, sid)); }
+inline BOOL SetSecurityDescriptorOwner (PSECURITY_DESCRIPTOR sd, PSID sid, BOOL defaulted) { return success (RtlSetOwnerSecurityDescriptor (sd, sid, defaulted != FALSE)); }
+inline BOOL SetSecurityDescriptorGroup (PSECURITY_DESCRIPTOR sd, PSID sid, BOOL defaulted) { return success (RtlSetGroupSecurityDescriptor (sd, sid, defaulted != FALSE)); }
+inline BOOL SetSecurityDescriptorDacl (PSECURITY_DESCRIPTOR sd, BOOL present, PACL acl, BOOL defaulted) { return success (RtlSetDaclSecurityDescriptor (sd, present != FALSE, acl, defaulted != FALSE)); }
+inline BOOL SetSecurityDescriptorSacl (PSECURITY_DESCRIPTOR sd, BOOL present, PACL acl, BOOL defaulted) { return success (RtlSetSaclSecurityDescriptor (sd, present != FALSE, acl, defaulted != FALSE)); }
+inline BOOL SetSecurityDescriptorControl (PSECURITY_DESCRIPTOR sd, SECURITY_DESCRIPTOR_CONTROL mask, SECURITY_DESCRIPTOR_CONTROL bits)
+{ return success (RtlSetControlSecurityDescriptor (sd, mask, bits)); }
+inline DWORD SetSecurityDescriptorRMControl (PSECURITY_DESCRIPTOR sd, PUCHAR value)
+{
+  RtlSetSecurityDescriptorRMControl (sd, value);
+  UCHAR copied = 0;
+  return RtlGetSecurityDescriptorRMControl (sd, &copied) && copied == *value ? ERROR_SUCCESS : ERROR_INVALID_SECURITY_DESCR;
+}
+}
+#endif

