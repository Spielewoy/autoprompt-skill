+BOOL appcontainer_create_pipe (PHANDLE, PHANDLE, LPSECURITY_ATTRIBUTES, DWORD);
+#endif
diff --git a/winsup/cygwin/local_includes/appcontainer_named_kernel.h b/winsup/cygwin/local_includes/appcontainer_named_kernel.h
new file mode 100644
index 0000000..6548c73
--- /dev/null
+++ b/winsup/cygwin/local_includes/appcontainer_named_kernel.h
@@ -0,0 +1,38 @@
+/* Source-only raw named-kernel-object adapter. Include after winsup.h. */
+#ifndef _APPCONTAINER_NAMED_KERNEL_H
+#define _APPCONTAINER_NAMED_KERNEL_H
+#include "ntdll.h"
+#include "appcontainer_pipe_security.h"
+
+/* Only synchronous object creation belongs here, never file/pipe I/O or
+   user filesystem security. Preserve the original attributes for later open
+   calls; a copied descriptor must never escape the owning helper's lifetime.
+   The callback runs exactly once after successful preparation, or directly
+   for unnamed/ordinary-host calls. */
+template <typename Create>
+static NTSTATUS
+appcontainer_named_kernel_create (PHANDLE target, POBJECT_ATTRIBUTES original,
+                                   Create create)
+{
+  if (!original || !original->ObjectName)
+    return create (original);
+  SECURITY_ATTRIBUTES source = { sizeof source, original->SecurityDescriptor,
+                                  (original->Attributes & OBJ_INHERIT) != 0 };
+  appcontainer_pipe_security security;
+  DWORD error = security.prepare (&source);
+  if (error)
+    {
+      /* Do not reinterpret a positive DWORD as NT_SUCCESS. Existing callers
+         retain their native-failure/errno/fatal branches; log the real cause. */
+      if (target)
+        *target = NULL;
+      debug_printf ("AppContainer named kernel descriptor failed, Win32 %u", error);
+      return static_cast<NTSTATUS> (0xc0000001); /* STATUS_UNSUCCESSFUL */
+    }
+  if (!security.is_appcontainer ())
+    return create (original);
+  OBJECT_ATTRIBUTES adapted = *original;
+  adapted.SecurityDescriptor = security.get ()->lpSecurityDescriptor;
+  return create (&adapted);
+}
+#endif
diff --git a/winsup/cygwin/local_includes/appcontainer_pipe_name.h b/winsup/cygwin/local_includes/appcontainer_pipe_name.h
new file mode 100644
index 0000000..a3857c6
--- /dev/null
+++ b/winsup/cygwin/local_includes/appcontainer_pipe_name.h
@@ -0,0 +1,30 @@
+/* Source-only helper proposal; requires appcontainer_pipe_security. */
+#ifndef _APPCONTAINER_PIPE_NAME_H
+#define _APPCONTAINER_PIPE_NAME_H
+
+/* Include after winsup.h and ntdll.h. One local object owns one current NT
+   pipe name; no cache/fork state. get() is read-only to callers and stays valid
+   only until the next prepare() or destruction. Complete the synchronous NT
+   call before preparing another name. Never concurrently use this object. */
+class appcontainer_pipe_name
+{
+  WCHAR buffer_[513];
+  UNICODE_STRING value_;
+  PUNICODE_STRING result_;
+  bool appcontainer_;
+  appcontainer_pipe_name (const appcontainer_pipe_name &) = delete;
+  appcontainer_pipe_name &operator= (const appcontainer_pipe_name &) = delete;
+public:
+  appcontainer_pipe_name ();
+  /* Returns an actual Win32 failure or explicit validation failure. Failure
+     leaves get()==NULL. Host success returns the exact original pointer;
+     AppContainer success returns this object's bounded owned name. Reusable
+     after each previous synchronous operation has finished. */
+  DWORD prepare (PUNICODE_STRING original);
+  PUNICODE_STRING get () const { return result_; }
+  bool is_appcontainer () const { return appcontainer_; }
+  /* Failure-only adapter for NT callers: log the actual DWORD separately.
+     Never use stale RtlGetLastNtStatus or cast a positive DWORD to NTSTATUS. */
+  static NTSTATUS error_status (DWORD error);
+};
+#endif
diff --git a/winsup/cygwin/local_includes/appcontainer_pipe_security.h b/winsup/cygwin/local_includes/appcontainer_pipe_security.h
new file mode 100644
index 0000000..597753b
--- /dev/null
+++ b/winsup/cygwin/local_includes/appcontainer_pipe_security.h
@@ -0,0 +1,31 @@
+/* Source-only prototype; not part of an installed or tested MSYS runtime. */
+#ifndef _APPCONTAINER_PIPE_SECURITY_H
+#define _APPCONTAINER_PIPE_SECURITY_H
+
+/* Include after winsup.h. One object owns one synchronous pipe-creation
+   descriptor. Do not retain it across fork or cache it in global storage. */
+class appcontainer_pipe_security
+{
+  SECURITY_ATTRIBUTES attributes_;
+  SECURITY_DESCRIPTOR descriptor_;
+  LPSECURITY_ATTRIBUTES result_;
+  void *storage_;
+  bool prepared_;
+  bool appcontainer_;
+
+  appcontainer_pipe_security (const appcontainer_pipe_security &) = delete;
+  appcontainer_pipe_security &operator=
+    (const appcontainer_pipe_security &) = delete;
+
+public:
+  appcontainer_pipe_security ();
+  ~appcontainer_pipe_security ();
+
+  /* Return a Win32 error. On error get() is NULL and callers MUST refuse the
+     pipe operation. On ordinary hosts get() is exactly source, including NULL.
+     In an AppContainer get() owns its complete descriptor until destruction. */
+  DWORD prepare (LPSECURITY_ATTRIBUTES source);
+  LPSECURITY_ATTRIBUTES get () const { return result_; }
+  bool is_appcontainer () const { return appcontainer_; }
+};
+#endif
diff --git a/winsup/cygwin/sec/appcontainer_pipe.cc b/winsup/cygwin/sec/appcontainer_pipe.cc
new file mode 100644
index 0000000..2d9caba
--- /dev/null
+++ b/winsup/cygwin/sec/appcontainer_pipe.cc
@@ -0,0 +1,284 @@
+/* Pipe-only AppContainer descriptor prototype.
+
+   Baseline: git-for-windows/msys2-runtime
+   270ba2980700e6e2a0813944d506eecea0f86402.
+   No global sec_acl change, no environment inputs and no cached token state.
+   This source has not been compiled or run in the MSYS build environment. */
+
+#include "winsup.h"
+#include <stdint.h>
+#include <string.h>
+#include "appcontainer_pipe_security.h"
+
+namespace
+{
+constexpr DWORD pipe_sd_limit = 128 * 1024;
+constexpr DWORD pipe_acl_limit = 0xffff;
+/* Legacy SECURITY_DESCRIPTOR_CONTROL bits are absent from the pinned headers.
+   Values are defined by Microsoft's security-descriptor-control contract. */
+constexpr SECURITY_DESCRIPTOR_CONTROL legacy_dacl_untrusted = 0x0040;
+constexpr SECURITY_DESCRIPTOR_CONTROL legacy_server_security = 0x0080;
+
+struct scoped_token
+{
+  HANDLE value;
+  scoped_token () : value (NULL) {}
+  ~scoped_token () { if (value) CloseHandle (value); }
+};
+
+/* Token information includes a pointer followed by an inline variable SID.
+   Check that pointer against the returned buffer before inspecting the SID. */
+bool
+bounded_sid (PSID sid, const void *buffer, DWORD size)
+{
+  uintptr_t start = reinterpret_cast<uintptr_t> (buffer);
+  uintptr_t value = reinterpret_cast<uintptr_t> (sid);
+  if (!sid || value < start || value - start > size
+      || size - (value - start) < 8)
+    return false;
+  DWORD remaining = size - (value - start);
+  BYTE count = *GetSidSubAuthorityCount (sid);
+  DWORD length = GetSidLengthRequired (count);
+  return length <= SECURITY_MAX_SID_SIZE && length <= remaining
+         && IsValidSid (sid);
+}
+
+union sid_buffer
+{
+  ULONG_PTR align;
+  BYTE bytes[SECURITY_MAX_SID_SIZE];
+};
+
+/* GetTokenInformation is used rather than a user-controlled SID string.
+   Buffers are fixed and bounded; an oversized or malformed result refuses. */
+DWORD
+token_sid (HANDLE token, TOKEN_INFORMATION_CLASS kind, sid_buffer &destination)
+{
+  union
+  {
+    ULONG_PTR align;
+    BYTE bytes[sizeof (TOKEN_USER) + SECURITY_MAX_SID_SIZE];
+  } information;
+  DWORD returned = 0;
+  if (!GetTokenInformation (token, kind, information.bytes,
+                            sizeof information, &returned))
+    return GetLastError ();
+  if (returned > sizeof information || returned < sizeof (PSID))
+    return ERROR_INVALID_DATA;
+  PSID sid = kind == TokenUser
+    ? reinterpret_cast<TOKEN_USER *> (information.bytes)->User.Sid
+    : reinterpret_cast<TOKEN_APPCONTAINER_INFORMATION *>
+        (information.bytes)->TokenAppContainer;
+  if (!bounded_sid (sid, information.bytes, returned))
+    return ERROR_INVALID_SID;
+  if (!CopySid (sizeof destination.bytes, destination.bytes, sid))
+    return GetLastError ();
+  return ERROR_SUCCESS;
+}
+
+DWORD
+sid_size (PSID sid)
+{
+  if (!sid)
+    return 0;
+  return IsValidSid (sid) ? GetLengthSid (sid) : 0xffffffff;
+}
+
+DWORD
+acl_used (PACL acl, ACL_SIZE_INFORMATION &info)
+{
+  if (!acl || !IsValidAcl (acl)
+      || !GetAclInformation (acl, &info, sizeof info, AclSizeInformation)
+      || (acl->AclSize & 3) || (info.AclBytesInUse & 3)
+      || info.AclBytesInUse < sizeof (ACL)
+      || info.AclBytesInUse > acl->AclSize
+      || (acl->AclRevision != ACL_REVISION
+          && acl->AclRevision != ACL_REVISION_DS))
+    return ERROR_INVALID_ACL;
+  return ERROR_SUCCESS;
+}
+}
+
+appcontainer_pipe_security::appcontainer_pipe_security ()
+  : attributes_ {}, descriptor_ {}, result_ (NULL), storage_ (NULL),
+    prepared_ (false), appcontainer_ (false)
+{
+}
+
+appcontainer_pipe_security::~appcontainer_pipe_security ()
+{
+  if (storage_)
+    HeapFree (GetProcessHeap (), 0, storage_);
+}
+
+DWORD
+appcontainer_pipe_security::prepare (LPSECURITY_ATTRIBUTES source)
+{
+  DWORD previous_last_error = GetLastError ();
+  result_ = NULL;
+  if (prepared_)
+    return ERROR_INVALID_FUNCTION;
+  prepared_ = true;
+
+  scoped_token token;
+  if (!OpenProcessToken (GetCurrentProcess (), TOKEN_QUERY, &token.value))
+    return GetLastError ();
+  DWORD container = 0, returned = 0;
+  if (!GetTokenInformation (token.value, TokenIsAppContainer, &container,
+                            sizeof container, &returned))
+    return GetLastError ();
+  if (returned != sizeof container || container > 1)
+    return ERROR_INVALID_DATA;
+  if (!container)
+    {
+      /* Do not inspect, normalize, copy or relabel an ordinary host SD. */
+      result_ = source;
+      CloseHandle (token.value);
+      token.value = NULL;
+      SetLastError (previous_last_error);
+      return ERROR_SUCCESS;
+    }
+  appcontainer_ = true;
+
+  if (source && source->nLength != sizeof (SECURITY_ATTRIBUTES))
+    return ERROR_INVALID_PARAMETER;
+  sid_buffer package, user, system;
+  DWORD error = token_sid (token.value, TokenAppContainerSid, package);
+  if (error)
+    return error;
+
+  PSECURITY_DESCRIPTOR supplied = source ? source->lpSecurityDescriptor : NULL;
+  PSID owner = NULL, group = NULL;
+  PACL old_dacl = NULL, old_sacl = NULL;
+  BOOL owner_defaulted = FALSE, group_defaulted = FALSE;
+  BOOL dacl_present = FALSE, dacl_defaulted = FALSE;
+  BOOL sacl_present = FALSE, sacl_defaulted = FALSE;
+  SECURITY_DESCRIPTOR_CONTROL control = 0;
+  UCHAR rm_control = 0;
+  DWORD revision = 0;
+  if (supplied)
+    {
+      if (!IsValidSecurityDescriptor (supplied)
+          || !GetSecurityDescriptorControl (supplied, &control, &revision)
+          || revision != SECURITY_DESCRIPTOR_REVISION
+          || !GetSecurityDescriptorOwner (supplied, &owner, &owner_defaulted)
+          || !GetSecurityDescriptorGroup (supplied, &group, &group_defaulted)
+          || !GetSecurityDescriptorDacl (supplied, &dacl_present, &old_dacl,
+                                         &dacl_defaulted)
+          || !GetSecurityDescriptorSacl (supplied, &sacl_present, &old_sacl,
+                                         &sacl_defaulted))
+        return ERROR_INVALID_SECURITY_DESCR;
+      /* These legacy control modes cannot be reproduced by the documented
+         component/inheritance setters below. Refuse rather than drop them. */
+      if (control & (legacy_dacl_untrusted | legacy_server_security))
+        return ERROR_INVALID_SECURITY_DESCR;
+      if ((control & SE_RM_CONTROL_VALID)
+          && (error = GetSecurityDescriptorRMControl (supplied, &rm_control)))
+        return error;
+    }
+
+  /* An absent/default/NULL DACL is not copied as broad access. Only these
+     cases receive the explicit private user+SYSTEM+package descriptor. An
+     explicit empty DACL remains empty except for the appended package ACE;
+     it does NOT acquire an otherwise missing user grant. */
+  bool private_default = !dacl_present || !old_dacl;
+  if (private_default)
+    {
+      error = token_sid (token.value, TokenUser, user);
+      if (error)
+        return error;
+      DWORD system_size = sizeof system.bytes;
+      if (!CreateWellKnownSid (WinLocalSystemSid, NULL, system.bytes,
+                               &system_size))
+        return GetLastError ();
+    }
+
+  DWORD owner_size = sid_size (owner), group_size = sid_size (group);
+  if (owner_size > SECURITY_MAX_SID_SIZE || group_size > SECURITY_MAX_SID_SIZE)
+    return ERROR_INVALID_SID;
+  ACL_SIZE_INFORMATION dacl_info {}, sacl_info {};
+  if (!private_default && (error = acl_used (old_dacl, dacl_info)))
+    return error;
+  if (sacl_present && old_sacl && (error = acl_used (old_sacl, sacl_info)))
+    return error;
+  DWORD original_aces = private_default ? 0
+    : dacl_info.AclBytesInUse - sizeof (ACL);
+  DWORD package_ace = sizeof (ACCESS_ALLOWED_ACE) - sizeof (DWORD)
+                      + GetLengthSid (package.bytes);
+  DWORD dacl_size = sizeof (ACL) + original_aces + package_ace;
+  if (private_default)
+    dacl_size += 2 * (sizeof (ACCESS_ALLOWED_ACE) - sizeof (DWORD))
+                 + GetLengthSid (user.bytes) + GetLengthSid (system.bytes);
+  DWORD sacl_size = sacl_present && old_sacl ? old_sacl->AclSize : 0;
+  DWORD total = owner_size + group_size + sacl_size + dacl_size;
+  if (dacl_size > pipe_acl_limit || sacl_size > pipe_acl_limit
+      || total > pipe_sd_limit)
+    return ERROR_ALLOTTED_SPACE_EXCEEDED;
+  storage_ = HeapAlloc (GetProcessHeap (), HEAP_ZERO_MEMORY, total);
+  if (!storage_)
+    return ERROR_NOT_ENOUGH_MEMORY;
+  BYTE *cursor = static_cast<BYTE *> (storage_);
+
+  /* Copy all components. Descriptor pointers never refer back to caller
+     storage or a token-query buffer after prepare returns. */
+  if (!InitializeSecurityDescriptor (&descriptor_, SECURITY_DESCRIPTOR_REVISION))
+    return GetLastError ();
+  PSID copied_owner = NULL, copied_group = NULL;
+  PACL copied_sacl = NULL;
+  if (owner_size)
+    { memcpy (cursor, owner, owner_size); copied_owner = cursor;
+      cursor += owner_size; }
+  if (group_size)
+    { memcpy (cursor, group, group_size); copied_group = cursor;
+      cursor += group_size; }
+  if (sacl_size)
+    { memcpy (cursor, old_sacl, sacl_size);
+      copied_sacl = reinterpret_cast<PACL> (cursor); cursor += sacl_size; }
+
+  PACL dacl = reinterpret_cast<PACL> (cursor);
+  DWORD acl_revision = private_default ? ACL_REVISION : old_dacl->AclRevision;
+  if (!InitializeAcl (dacl, dacl_size, acl_revision))
+    return GetLastError ();
+  if (original_aces
+      && !AddAce (dacl, acl_revision, MAXDWORD,
+                   reinterpret_cast<BYTE *> (old_dacl) + sizeof (ACL),
+                   original_aces))
+    return GetLastError ();
+  if (private_default
+      && (!AddAccessAllowedAceEx (dacl, acl_revision, 0, GENERIC_ALL, user.bytes)
+          || !AddAccessAllowedAceEx (dacl, acl_revision, 0, GENERIC_ALL,
+                                     system.bytes)))
+    return GetLastError ();
+  /* Append AFTER every original ACE. Preserve every deny/allow byte and its
+     order. Never insert the new allow in front of an existing inherited deny.
+     This does not promise canonical reordering; authorization remains subject
+     to the original restrictions and the OS object access check. */
+  if (!AddAccessAllowedAceEx (dacl, acl_revision, 0, GENERIC_ALL, package.bytes))
+    return GetLastError ();
+  if (!SetSecurityDescriptorOwner (&descriptor_, copied_owner, owner_defaulted)
+      || !SetSecurityDescriptorGroup (&descriptor_, copied_group, group_defaulted)
+      || !SetSecurityDescriptorSacl (&descriptor_, sacl_present, copied_sacl,
+                                     sacl_defaulted)
+      || !SetSecurityDescriptorDacl (&descriptor_, TRUE, dacl, dacl_defaulted))
+    return GetLastError ();
+  const SECURITY_DESCRIPTOR_CONTROL inheritance = SE_DACL_AUTO_INHERIT_REQ
+    | SE_SACL_AUTO_INHERIT_REQ | SE_DACL_AUTO_INHERITED | SE_SACL_AUTO_INHERITED
+    | SE_DACL_PROTECTED | SE_SACL_PROTECTED;
+  if (!SetSecurityDescriptorControl (&descriptor_, inheritance,
+                                     control & inheritance))
+    return GetLastError ();
+  if ((control & SE_RM_CONTROL_VALID)
+      && (error = SetSecurityDescriptorRMControl (&descriptor_, &rm_control)))
+    return error;
+  SECURITY_DESCRIPTOR_CONTROL copied_control;
+  if (!GetSecurityDescriptorControl (&descriptor_, &copied_control, &revision)
+      || copied_control != ((control & ~SE_SELF_RELATIVE) | SE_DACL_PRESENT))
+    return ERROR_INVALID_SECURITY_DESCR;
+  if (!IsValidSecurityDescriptor (&descriptor_))
+    return ERROR_INVALID_SECURITY_DESCR;
+  attributes_.nLength = sizeof attributes_;
+  attributes_.lpSecurityDescriptor = &descriptor_;
+  attributes_.bInheritHandle = source ? source->bInheritHandle : FALSE;
+  result_ = &attributes_;
+  return ERROR_SUCCESS;
+}
diff --git a/winsup/cygwin/sec/appcontainer_pipe_name.cc b/winsup/cygwin/sec/appcontainer_pipe_name.cc
new file mode 100644
index 0000000..288fc5c
--- /dev/null
+++ b/winsup/cygwin/sec/appcontainer_pipe_name.cc
@@ -0,0 +1,239 @@
+/* Source-only NT pipe-name adapter proposal for pinned git-for-windows/MSYS
+   270ba2980700e6e2a0813944d506eecea0f86402. Requires the pipe-security helper.
+   No global state, guessed profile path, environment input or retry fallback. */
+#include "winsup.h"
+#include <stdint.h>
+#include <string.h>
+#include <ntsecapi.h>
+#include "ntdll.h"
+#include "appcontainer_pipe_security.h"
+#include "appcontainer_pipe_name.h"
+
+namespace
+{
+constexpr size_t name_limit = 512;
+static const WCHAR npfs[] = L"\\Device\\NamedPipe\\";
+static const WCHAR local[] = L"\\\\.\\pipe\\LOCAL\\";
+static const WCHAR probe_intro[] = L"autoprompt-msys-name-";
+constexpr size_t npfs_units = sizeof npfs / sizeof (WCHAR) - 1;
+constexpr size_t local_units = sizeof local / sizeof (WCHAR) - 1;
+constexpr size_t intro_units = sizeof probe_intro / sizeof (WCHAR) - 1;
+constexpr size_t suffix_units = intro_units + 32;
+
+bool valid_handle (HANDLE handle)
+{ return handle && handle != INVALID_HANDLE_VALUE; }
+
+struct owned_pair
+{
+  HANDLE server, client;
+  owned_pair () : server (NULL), client (NULL) {}
+  DWORD close ()
+  {
+    DWORD error = ERROR_SUCCESS;
+    if (valid_handle (client) && !CloseHandle (client))
+      { error = GetLastError (); if (!error) error = ERROR_GEN_FAILURE; }
+    client = NULL;
+    if (valid_handle (server) && !CloseHandle (server))
+      { DWORD next = GetLastError (); if (!error) error = next ? next : ERROR_GEN_FAILURE; }
+    server = NULL;
+    return error;
+  }
+  ~owned_pair () { close (); }
+};
+
+bool name_character (WCHAR c)
+{
+  return (c >= L'a' && c <= L'z') || (c >= L'A' && c <= L'Z')
+         || (c >= L'0' && c <= L'9') || c == L'-' || c == L'_'
+         || c == L'.' || c == L'{' || c == L'}';
+}
+
+bool components_valid (const WCHAR *name, size_t units, bool separators)
+{
+  if (!units)
+    return false;
+  size_t component = 0;
+  for (size_t i = 0; i <= units; ++i)
+    {
+      if (i == units || (separators && name[i] == L'\\'))
+        {
+          size_t length = i - component;
+          if (!length || (length == 1 && name[component] == L'.')
+              || (length == 2 && name[component] == L'.'
+                  && name[component + 1] == L'.'))
+            return false;
+          component = i + 1;
+        }
+      else if (!name_character (name[i]))
+        return false;
+    }
+  return true;
+}
+
+/* Query one held handle once. Never trust a pointer outside returned storage,
+   a truncated kernel name, or an unrelated endpoint's suffix. */
+DWORD query_name (HANDLE handle, const WCHAR *suffix, WCHAR *destination,
+                  size_t &units)
+{
+  union { ULONG_PTR align; BYTE bytes[4096]; } storage;
+  ULONG returned = 0;
+  NTSTATUS status = NtQueryObject (handle, ObjectNameInformation,
+                                   storage.bytes, sizeof storage, &returned);
+  if (status != STATUS_SUCCESS)
+    {
+      DWORD error = RtlNtStatusToDosError (status);
+      return error ? error : ERROR_INVALID_DATA;
+    }
+  if (returned < sizeof (OBJECT_NAME_INFORMATION) || returned > sizeof storage)
+    return ERROR_INVALID_DATA;
+  UNICODE_STRING &name = reinterpret_cast<OBJECT_NAME_INFORMATION *>
+                          (storage.bytes)->Name;
+  uintptr_t begin = reinterpret_cast<uintptr_t> (storage.bytes);
+  uintptr_t pointer = reinterpret_cast<uintptr_t> (name.Buffer);
+  if (!name.Buffer || pointer < begin || pointer - begin < sizeof (OBJECT_NAME_INFORMATION)
+      || pointer - begin > returned || !name.Length || name.Length % sizeof (WCHAR)
+      || name.Length > name_limit * sizeof (WCHAR) || name.MaximumLength < name.Length
+      || name.Length > returned - (pointer - begin)
+      || pointer % alignof (WCHAR))
+    return ERROR_INVALID_DATA;
+  units = name.Length / sizeof (WCHAR);
+  if (units <= npfs_units + suffix_units ||
+      name.Buffer[units - suffix_units - 1] != L'\\' ||
+      memcmp (name.Buffer + units - suffix_units, suffix,
+               suffix_units * sizeof (WCHAR)))
+    return ERROR_INVALID_NAME;
+  UNICODE_STRING observed_root { static_cast<USHORT> (npfs_units * sizeof (WCHAR)),
+                                 static_cast<USHORT> (npfs_units * sizeof (WCHAR)),
+                                 name.Buffer };
+  UNICODE_STRING expected_root { static_cast<USHORT> (npfs_units * sizeof (WCHAR)),
+                                 static_cast<USHORT> (sizeof npfs),
+                                 const_cast<PWCHAR> (npfs) };
+  if (!RtlEqualUnicodeString (&observed_root, &expected_root, TRUE)
+      || !components_valid (name.Buffer + npfs_units, units - npfs_units, true))
+    return ERROR_INVALID_NAME;
+  memcpy (destination, name.Buffer, name.Length);
+  destination[units] = L'\0';
+  return ERROR_SUCCESS;
+}
+}
+
+appcontainer_pipe_name::appcontainer_pipe_name ()
+  : buffer_ {}, value_ {}, result_ (NULL), appcontainer_ (false)
+{
+}
+
+NTSTATUS appcontainer_pipe_name::error_status (DWORD error)
+{
+  switch (error)
+    {
+    case ERROR_SUCCESS: return STATUS_SUCCESS;
+    case ERROR_ACCESS_DENIED: return static_cast<NTSTATUS> (0xc0000022);
+    case ERROR_NOT_ENOUGH_MEMORY:
+    case ERROR_OUTOFMEMORY: return static_cast<NTSTATUS> (0xc0000017);
+    case ERROR_INVALID_PARAMETER:
+    case ERROR_INVALID_DATA: return static_cast<NTSTATUS> (0xc000000d);
+    case ERROR_INVALID_NAME: return static_cast<NTSTATUS> (0xc0000033);
+    case ERROR_FILENAME_EXCED_RANGE: return static_cast<NTSTATUS> (0xc0000106);
+    case ERROR_FILE_NOT_FOUND: return static_cast<NTSTATUS> (0xc0000034);
+    case ERROR_PATH_NOT_FOUND: return static_cast<NTSTATUS> (0xc000003a);
+    case ERROR_ALREADY_EXISTS:
+    case ERROR_FILE_EXISTS: return static_cast<NTSTATUS> (0xc0000035);
+    case ERROR_PIPE_BUSY: return static_cast<NTSTATUS> (0xc00000ae);
+    case ERROR_NOT_SUPPORTED: return static_cast<NTSTATUS> (0xc00000bb);
+    default: return static_cast<NTSTATUS> (0xc0000001);
+    }
+}
+
+DWORD appcontainer_pipe_name::prepare (PUNICODE_STRING original)
+{
+  result_ = NULL;
+  appcontainer_ = false;
+  /* Deliberately do not validate/dereference/normalize a host name. The
+     existing security helper verifies the actual primary process token. */
+  appcontainer_pipe_security security;
+  DWORD error = security.prepare (NULL);
+  if (error)
+    return error;
+  if (!security.is_appcontainer ())
+    {
+      result_ = original;
+      return ERROR_SUCCESS;
+    }
+  appcontainer_ = true;
+  if (!original || !original->Buffer || !original->Length
+      || original->Length % sizeof (WCHAR)
+      || original->Length > name_limit * sizeof (WCHAR)
+      || original->MaximumLength < original->Length)
+    return ERROR_INVALID_NAME;
+  /* A previous get() cannot be fed back as input: it is already adapted and
+     is invalidated by this call. Reject overlapping owned storage explicitly. */
+  uintptr_t input_pointer = reinterpret_cast<uintptr_t> (original->Buffer);
+  uintptr_t owned_pointer = reinterpret_cast<uintptr_t> (buffer_);
+  if (original == &value_ || (input_pointer >= owned_pointer
+                             && input_pointer - owned_pointer < sizeof buffer_))
+    return ERROR_INVALID_PARAMETER;
+  size_t original_units = original->Length / sizeof (WCHAR);
+  /* MSYS synthesizes these ASCII relative basenames (not user paths).
+     Refuse separators, embedded NULs, controls, colon and dot components. */
+  if (!components_valid (original->Buffer, original_units, false))
+    return ERROR_INVALID_NAME;
+
+  BYTE random[16];
+  /* RtlGenRandom's BOOLEAN contract does not document a GetLastError value.
+     An RNG refusal therefore has an explicit generic failure, never stale 0. */
+  if (!RtlGenRandom (random, sizeof random))
+    return ERROR_GEN_FAILURE;
+  static const WCHAR digits[] = L"0123456789abcdef";
+  WCHAR suffix[suffix_units + 1], win32_name[local_units + suffix_units + 1];
+  memcpy (suffix, probe_intro, intro_units * sizeof (WCHAR));
+  for (size_t i = 0; i < sizeof random; ++i)
+    {
+      suffix[intro_units + i * 2] = digits[random[i] >> 4];
+      suffix[intro_units + i * 2 + 1] = digits[random[i] & 15];
+    }
+  suffix[suffix_units] = L'\0';
+  memcpy (win32_name, local, local_units * sizeof (WCHAR));
+  memcpy (win32_name + local_units, suffix, sizeof suffix);
+
+  /* Security descriptor and handles remain owned through both connected-end
+     queries. First-instance creation refuses collisions; there is no retry. */
+  owned_pair probe;
+  probe.server = CreateNamedPipeW (win32_name,
+                   PIPE_ACCESS_INBOUND | FILE_FLAG_FIRST_PIPE_INSTANCE,
+                   PIPE_TYPE_MESSAGE | PIPE_READMODE_BYTE | PIPE_REJECT_REMOTE_CLIENTS,
+                   1, 8192, 8192, 50, security.get ());
+  if (!valid_handle (probe.server))
+    { error = GetLastError (); return error ? error : ERROR_GEN_FAILURE; }
+  probe.client = CreateFileW (win32_name, GENERIC_WRITE | FILE_READ_ATTRIBUTES,
+                              0, security.get (), OPEN_EXISTING, 0, NULL);
+  if (!valid_handle (probe.client))
+    { error = GetLastError (); return error ? error : ERROR_GEN_FAILURE; }
+  WCHAR server_name[name_limit + 1], client_name[name_limit + 1];
+  size_t server_units = 0, client_units = 0;
+  error = query_name (probe.server, suffix, server_name, server_units);
+  if (error)
+    return error;
+  error = query_name (probe.client, suffix, client_name, client_units);
+  if (error)
+    return error;
+  if (server_units != client_units ||
+      memcmp (server_name, client_name, server_units * sizeof (WCHAR)))
+    return ERROR_INVALID_NAME;
+  size_t prefix_units = server_units - suffix_units - npfs_units;
+  if (!prefix_units || prefix_units + original_units > name_limit)
+    return ERROR_FILENAME_EXCED_RANGE;
+  /* Prefix is the exact opaque object-manager result, excluding only the
+     known NPFS root and our own nonce basename. No SID path is reconstructed. */
+  memcpy (buffer_, server_name + npfs_units, prefix_units * sizeof (WCHAR));
+  memcpy (buffer_ + prefix_units, original->Buffer, original->Length);
+  size_t total_units = prefix_units + original_units;
+  buffer_[total_units] = L'\0';
+  error = probe.close ();
+  if (error)
+    return error;
+  value_.Buffer = buffer_;
+  value_.Length = static_cast<USHORT> (total_units * sizeof (WCHAR));
+  value_.MaximumLength = static_cast<USHORT> ((total_units + 1) * sizeof (WCHAR));
+  result_ = &value_;
+  return ERROR_SUCCESS;
+}
