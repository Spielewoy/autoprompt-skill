+/* CreatePipe chooses an inaccessible bare NPFS name in an AppContainer.
+   These two MSYS-internal users need synchronous byte pipes, not the message
+   and FILE_READ_ATTRIBUTES behavior of fhandler_pipe::create. */
+static BOOL
+create_appcontainer_anonymous_pipe (PHANDLE read_pipe, PHANDLE write_pipe,
+                                   LPSECURITY_ATTRIBUTES attributes,
+                                   DWORD size)
+{
+  if (!read_pipe || !write_pipe || read_pipe == write_pipe || size > 65536)
+    {
+      SetLastError (ERROR_INVALID_PARAMETER);
+      return FALSE;
+    }
+  *read_pipe = NULL;
+  *write_pipe = NULL;
+  for (unsigned attempt = 0; attempt < 8; ++attempt)
+    {
+      BYTE nonce[16];
+      if (!RtlGenRandom (nonce, sizeof nonce))
+        {
+          /* RtlGenRandom does not specify GetLastError on failure. */
+          SetLastError (ERROR_GEN_FAILURE);
+          return FALSE;
+        }
+      WCHAR name[80] = L"\\\\.\\pipe\\LOCAL\\msys-anon-";
+      static const WCHAR hex[] = L"0123456789abcdef";
+      size_t offset = wcslen (name);
+      for (size_t i = 0; i < sizeof nonce; ++i)
+        {
+          name[offset++] = hex[nonce[i] >> 4];
+          name[offset++] = hex[nonce[i] & 15];
+        }
+      name[offset] = L'\0';
+      HANDLE reader = CreateNamedPipeW
+        (name, PIPE_ACCESS_INBOUND | FILE_FLAG_FIRST_PIPE_INSTANCE,
+         PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT
+         | PIPE_REJECT_REMOTE_CLIENTS,
+         1, size, size, 0, attributes);
+      if (reader == INVALID_HANDLE_VALUE)
+        {
+          DWORD error = GetLastError ();
+          if (error == ERROR_PIPE_BUSY && attempt + 1 < 8)
+            continue;
+          SetLastError (error ? error : ERROR_GEN_FAILURE);
+          return FALSE;
+        }
+      HANDLE writer = CreateFileW (name, GENERIC_WRITE, 0, attributes,
+                                  OPEN_EXISTING, 0, NULL);
+      if (writer == INVALID_HANDLE_VALUE)
+        {
+          DWORD error = GetLastError ();
+          CloseHandle (reader);
+          SetLastError (error ? error : ERROR_GEN_FAILURE);
+          return FALSE;
+        }
+      *read_pipe = reader;
+      *write_pipe = writer;
+      return TRUE;
+    }
+  SetLastError (ERROR_PIPE_BUSY);
+  return FALSE;
+}
