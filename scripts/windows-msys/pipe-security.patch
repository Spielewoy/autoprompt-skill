       CloseHandle (h); \
   } while (0)
 
+/* Every direct master-control reopen must use the same actual-token name
+   policy as the listener.  No environment-derived namespace is accepted. */
+static DWORD
+pty_control_pipe_name (char (&name)[MAX_PATH], int unit, bool appcontainer)
+{
+  if (appcontainer)
+    {
+      const UNICODE_STRING &key = cygheap->installation_key;
+      bool valid = key.Buffer && key.Length == 16 * sizeof (WCHAR)
+                   && key.MaximumLength >= key.Length && unit >= 0;
+      for (size_t i = 0; valid && i < 16; ++i)
+        valid = (key.Buffer[i] >= L'0' && key.Buffer[i] <= L'9')
+                || (key.Buffer[i] >= L'a' && key.Buffer[i] <= L'f')
+                || (key.Buffer[i] >= L'A' && key.Buffer[i] <= L'F');
+      if (!valid)
+        return ERROR_INVALID_DATA;
+    }
+#ifdef __MSYS__
+  const char *prefix = appcontainer ? "\\\\.\\pipe\\LOCAL\\msys-"
+                                   : "\\\\.\\pipe\\msys-";
+#else
+  const char *prefix = appcontainer ? "\\\\.\\pipe\\LOCAL\\cygwin-"
+                                   : "\\\\.\\pipe\\cygwin-";
+#endif
+  /* AC input is bounded above: 16 hex digits and at most 10 decimal digits.
+     The ordinary-host formatter retains the existing name unchanged. */
+  __small_sprintf (name, "%s%S-pty%d-master-ctl", prefix,
+                   &cygheap->installation_key, unit);
+  return ERROR_SUCCESS;
+}
+
+static bool
+pty_control_pipe_name (char (&name)[MAX_PATH], int unit)
+{
+  DWORD error;
+  {
+    appcontainer_pipe_security security;
+    error = security.prepare (NULL);
+    if (!error)
+      error = pty_control_pipe_name (name, unit, security.is_appcontainer ());
+  }
+  /* Restore after owned descriptor cleanup, including on an ordinary host. */
+  if (error)
+    SetLastError (error);
+  return !error;
+}
+
+static HANDLE
+create_pty_control_pipe (char (&name)[MAX_PATH], int unit)
+{
