 details. */
 
 #include "winsup.h"
+#include "appcontainer_anonymous_pipe.h"
 #include <stdlib.h>
 #include <sys/param.h>
 #include <cygwin/acl.h>
 #include <cygwin/kd.h>
 #include "cygerrno.h"
