+BOOL
+appcontainer_create_pipe (PHANDLE read_pipe, PHANDLE write_pipe,
+                          LPSECURITY_ATTRIBUTES attributes, DWORD size)
+{
+  DWORD error = GetLastError ();
+  BOOL result = FALSE;
+  {
