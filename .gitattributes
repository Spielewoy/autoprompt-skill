# Preserve POSIX script line endings for Windows contributors and any
# cross-platform checkout, so `#!/usr/bin/env node` cannot become `node\r`.
*.cjs text eol=lf
*.sh text eol=lf
bin/** text eol=lf
tests/fixtures/codex-route-holdout-v2.jsonl text eol=lf
agents/codex/** text eol=lf
agents/manifests/codex-runtime.json text eol=lf
packages/codex/** text eol=lf
# These bytes participate in the Codex install/runtime trust hashes too.
agents/contracts/** text eol=lf
scripts/install/*.json text eol=lf
scripts/install/codex-discovery-shim.md text eol=lf
